# Postgres. One database per client app; the server runs migrations on boot.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Signs sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Public origin, used for auth callbacks and cookie domain.
APP_URL=http://localhost:5173

PORT=3000

# Per-minute rate limits, per caller and per group. Defaults are
# read=1200 write=600 upload=60 public=10.
# RATE_LIMIT_READ=1200
# RATE_LIMIT_WRITE=600
# RATE_LIMIT_UPLOAD=60
# RATE_LIMIT_PUBLIC=10
